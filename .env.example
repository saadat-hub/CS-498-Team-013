NODE_ENV=production
API_PORT=8080
# Comma-separated trusted reverse-proxy IPs/CIDRs; empty trusts no forwarded addresses.
TRUST_PROXY=
# Required: HTTPS origins and reachable PostgreSQL 16 / Redis 7 service URLs.
APP_ORIGIN=
API_URL=
DATABASE_URL=
DATABASE_POOL_MAX=20
REDIS_URL=
# Required: independent, cryptographically random secrets of at least 32 characters.
SESSION_SECRET=
IP_HASH_SECRET=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
TOKEN_COUNT_MODEL=
RUN_MODEL=
JUDGE_MODEL=
# Required: JSON mapping selected model IDs to in_per_mtok and out_per_mtok prices.
PRICES_JSON={}
LLM_DAILY_BUDGET_USD=50
USER_DAILY_MODEL_RUNS=40
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FEATURE_CODE_TESTS=false
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRICS_EXPORTER=none
